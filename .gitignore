# Keep source and workflows; generated photo records live outside Git.
/*
!/.gitignore
!/Makefile
!/*.py
!/*.sh
!/*.ml
!/*.c
!/*.md
!/requirements.txt
!/.python-version
!/pyproject.toml
!/uv.lock
!/rust-toolchain.toml
!/LICENSE
!/AGENTS.md
!/FIRSTPAIR.md
!/book.build.json
!/docs/
!/cover/
!/dist/
!/rust-scanner/
!/turso-ffi/
!/ocaml-exiftool-rs/
/ocaml-exiftool-rs/_build/
/rustup-init.sh
/rust-scanner/*
!/rust-scanner/Cargo.toml
!/rust-scanner/Cargo.lock
!/rust-scanner/README.md
!/rust-scanner/src/
!/rust-scanner/exiftool-ffi/
!/rust-scanner/tests/
!/rust-scanner/rust-toolchain.toml
/docs/**/__pycache__/
/docs/**/.DS_Store
/cover/.DS_Store
