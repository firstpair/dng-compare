opam-version: "2.0"
name: "dng-exiftool-rs"
version: "0.1.0"
synopsis: "In-process exiftool-rs metadata extraction for OCaml and OxCaml over a C ABI"
description: """
Binds the dng-exiftool-ffi C ABI (a Rust library wrapping the exiftool-rs
crate) and runs a domain-parallel extraction pool. Builds with stock OCaml 5
(Domain.spawn) and with OxCaml (Domain.Safe.spawn with portable closures).
The linked engine is GPL-3.0-or-later; see THIRD-PARTY notes in the README.
"""
maintainer: "Alexy Khrabrov"
authors: ["Alexy Khrabrov"]
license: "MIT"
homepage: "https://github.com/firstpair/dng-compare"
bug-reports: "https://github.com/firstpair/dng-compare/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.9"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
